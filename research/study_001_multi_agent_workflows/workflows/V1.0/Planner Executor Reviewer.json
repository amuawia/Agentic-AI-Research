        "jsCode": "const raw = $json.output;\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(raw);\n} catch (error) {\n  parsed = {\n    task_id: \"1\",\n    quality_score: 0,\n    review_notes: raw,\n    final_answer: raw,\n    confidence: 0\n  };\n}\n\nreturn [\n  {\n    json: {\n      task_id: parsed.task_id || \"1\",\n      answer: parsed.final_answer || \"\",\n      execution_summary: parsed.review_notes || \"\",\n      confidence: parsed.confidence || 0,\n      quality_score: parsed.quality_score || 0,\n      raw_output: raw\n    }\n  }\n];"
      },
