    {
      "parameters": {
        "jsCode": "// V1.4.4 - Planner Executor - all LLM call token estimation\n\nconst startMs = $('Set Start Time').item.json.start_ms || Date.now();\nconst endMs = Date.now();\nconst durationSec = Math.round((endMs - startMs) / 100) / 10;\n\nconst startIso = new Date(startMs).toISOString();\nconst endIso = new Date(endMs).toISOString();\n\nlet raw = $json.output || \"\";\n\nraw = raw\n  .replace(/^```json\\s*/i, '')\n  .replace(/^```\\s*/i, '')\n  .replace(/\\s*```$/i, '')\n  .trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  parsed = {\n    task_id: \"1\",\n    answer: raw,\n    execution_summary: \"Failed to parse JSON output\",\n    confidence: 0,\n    quality_score: 0\n  };\n}\n\nconst task_id = parsed.task_id || \"1\";\nconst answer = parsed.answer || parsed.final_answer || \"\";\nconst execution_summary = parsed.execution_summary || parsed.review_notes || \"\";\nlet confidence = parsed.confidence !== undefined && parsed.confidence !== null ? Number(parsed.confidence) : 0;\n\nif (confidence > 1 && confidence <= 10) {\n  confidence = confidence / 10;\n}\n\nconfidence = Math.max(0, Math.min(1, confidence));\nconst quality_score =\n  parsed.quality_score !== undefined && parsed.quality_score !== null\n    ? Math.max(0, Math.min(1, Number(parsed.quality_score)))\n    : confidence;\n\nconst userPrompt = $('When chat message received').item.json.chatInput || \"\";\n\nconst plannerSystemPrompt = `You are a planning agent.\n\nAnalyze the user request.\n\nCreate a step-by-step execution plan.\nKeep the plan concise. Do not exceed 120 words.\nReturn no more than 5 steps.\nConfidence must be a decimal value between 0.0 and 1.0.\n\nReturn ONLY valid JSON.\n\n{\n  \"task_id\":\"1\",\n  \"objective\":\"...\",\n  \"steps\":[\n    \"step1\",\n    \"step2\",\n    \"step3\"\n  ],\n  \"confidence\":0.0\n}`;\n\nconst executorSystemPrompt = `You are an execution agent.\n\nExecute the plan received from the planner.\nKeep the final answer concise and structured.\nDo not exceed 250 words.\nThe \"answer\" field must be a plain text string, not an object or array.\nConfidence must be a decimal value between 0.0 and 1.0.\n\nReturn ONLY valid JSON.\n\n{\n  \"task_id\": \"1\",\n  \"answer\": \"...\",\n  \"execution_summary\": \"...\",\n  \"confidence\": 0.0\n}`;\n\nconst plannerOutput = $('Planner Agent').item.json.output || \"\";\nconst executorOutput = raw;\n\nconst plannerInputText =\n  plannerSystemPrompt + \"\\n\" +\n  userPrompt;\n\nconst executorInputText =\n  executorSystemPrompt + \"\\n\" +\n  \"Execute the following plan and produce the final answer:\\n\\n\" +\n  plannerOutput;\n\nconst inputTokens =\n  Math.max(1, Math.round(plannerInputText.length / 4)) +\n  Math.max(1, Math.round(executorInputText.length / 4));\n\nconst outputTokens =\n  Math.max(1, Math.round(plannerOutput.length / 4)) +\n  Math.max(1, Math.round(executorOutput.length / 4));\n\nconst totalTokens = inputTokens + outputTokens;\n\nconst inputPricePer1M = 2.5;\nconst outputPricePer1M = 15.0;\n\nconst costUsd = Number(((inputTokens / 1000000 * inputPricePer1M) + (outputTokens / 1000000 * outputPricePer1M)).toFixed(6));\n\nreturn [{\n  json: {\n    task_id,\n    answer,\n    execution_summary,\n    confidence,\n    quality_score,\n    raw_output: raw,\n    duration_sec: durationSec,\n    input_tokens: inputTokens,\n    output_tokens: outputTokens,\n    total_tokens: totalTokens,\n    cost_usd: costUsd,\n    cost_method: \"estimated_char_count_all_llm_calls\",\n    input_token_method: \"estimated_effective_prompt_length_all_llm_calls\",\n    output_token_method: \"estimated_all_llm_outputs_length\",\n    error_message: \"token_count_estimated\",\n    retry_count: 0,\n    model_temperature: 1.0,\n    api_status: \"success\",\n    workflow_version: \"V1.4.4\",\n    prompt_version: \"frozen_v1.1\",\n    llm_call_count: 2,\n    start_time_iso: startIso,\n    end_time_iso: endIso,\n    input_price_per_1m: inputPricePer1M,\n    output_price_per_1m: outputPricePer1M\n  }\n}];"
      },
