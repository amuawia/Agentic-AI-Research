    {
      "parameters": {
        "jsCode": "// ── Duration ─────────────────────────────────────────────────────────────────\nconst startMs = $('Set Start Time').item.json.start_ms || Date.now();\nconst durationSec = Math.round((Date.now() - startMs) / 100) / 10;\n\n// ── Parse agent JSON output ───────────────────────────────────────────────────\nconst raw=$json.output;\nlet parsed;\ntry{parsed=JSON.parse(raw);}catch(e){parsed={task_id:\"1\",answer:raw,execution_summary:\"Failed to parse JSON output\",confidence:0};}\nconst task_id=parsed.task_id||\"1\";\nconst answer = parsed.answer || parsed.final_answer || \"\";\nconst execution_summary = parsed.execution_summary || parsed.review_notes || \"\";\nconst quality_score=parsed.quality_score||0;\nconst confidence=parsed.confidence||0;\n\n// ── Token counting ────────────────────────────────────────────────────────────\nlet inputTokens = 0, outputTokens = 0;\nconst errors = [];\n\n// Model node: OpenAI Chat Model\ntry {\n  const ctx0 = $node['OpenAI Chat Model'].context || {};\n  // n8n >= 1.31: lmChatOpenAi stores usage under tokenUsage or usageMetadata\n  const usage0 = ctx0.tokenUsage || ctx0.usageMetadata || ctx0.usage || {};\n  // OpenAI field names\n  inputTokens  += usage0.promptTokens      || usage0.inputTokens   || usage0.prompt_tokens    || 0;\n  outputTokens += usage0.completionTokens  || usage0.outputTokens  || usage0.completion_tokens || 0;\n} catch(e) { errors.push('token_read_OpenAI Chat Model: ' + e.message); }\n\n// Model node: OpenAI Chat Model\ntry {\n  const ctx1 = $node['OpenAI Chat Model'].context || {};\n  // n8n >= 1.31: lmChatOpenAi stores usage under tokenUsage or usageMetadata\n  const usage1 = ctx1.tokenUsage || ctx1.usageMetadata || ctx1.usage || {};\n  // OpenAI field names\n  inputTokens  += usage1.promptTokens      || usage1.inputTokens   || usage1.prompt_tokens    || 0;\n  outputTokens += usage1.completionTokens  || usage1.outputTokens  || usage1.completion_tokens || 0;\n} catch(e) { errors.push('token_read_OpenAI Chat Model: ' + e.message); }\n\n// Fallback: estimate from text length if tokens still 0\n// (~4 chars per token is standard approximation)\nif (inputTokens === 0 && outputTokens === 0) {\n  const chatInput = $('When chat message received').item.json.chatInput || '';\n  inputTokens  = Math.round(chatInput.length / 4);\n  outputTokens = Math.round(raw.length / 4);\n  errors.push('token_count_estimated');\n}\n\nconst totalTokens = inputTokens + outputTokens;\nconst costUsd = parseFloat(((inputTokens / 1e6 * 2.5) + (outputTokens / 1e6 * 10.0)).toFixed(6));\n\n// ── New fields ────────────────────────────────────────────────────────────────\nconst errorMessage   = errors.length > 0 ? errors.join('; ') : '';\nconst retryCount     = 0;   // n8n doesn't expose retry count natively - hardcoded\nconst modelTemp      = 1.0; // default OpenAI temp; change if you set it in node options\nconst apiStatus      = 'success'\nconst costMethod = errors.includes('token_count_estimated') ? 'estimated_char_count' : 'api_usage';\n\nreturn [{\n  json: {\n    task_id,\n    answer,\n    execution_summary,\n    confidence,\n    quality_score,\n    raw_output: raw,\n    duration_sec:    durationSec,\n    input_tokens:    inputTokens,\n    output_tokens:   outputTokens,\n    total_tokens:    totalTokens,\n    cost_usd:        costUsd,\n    error_message:   errorMessage,\n    retry_count:     retryCount,\n    model_temperature: modelTemp,\n    api_status:      apiStatus,\n    cost_method:     costMethod\n  }\n}];"
      },
