    {
      "parameters": {
        "jsCode": "// Agentic AI Experiment Parser V1.4\n// Workflow: basic_agent\n// Purpose: parse output, estimate effective input/output tokens, and record IEEE-ready execution metrics.\n\nconst WORKFLOW_VERSION = \"V1.4\";\nconst PROMPT_VERSION = \"frozen_v1\";\nconst PROVIDER = \"OpenAI\";\nconst MODEL = \"GPT-5.5\";\nconst LLM_CALL_COUNT = 1;\n\n// Keep these values aligned with the pricing used for your experiment.\n// If pricing changes, update these two values before a new experimental batch.\nconst INPUT_PRICE_PER_1M = 2.5;\nconst OUTPUT_PRICE_PER_1M = 10.0;\n\nconst startMs = $('Set Start Time').item.json.start_ms || Date.now();\nconst startTimeIso = $('Set Start Time').item.json.start_time_iso || \"\";\nconst endTimeIso = new Date().toISOString();\nconst durationSec = Math.round((Date.now() - startMs) / 100) / 10;\n\nconst raw = $json.output || \"\";\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  parsed = {\n    task_id: \"1\",\n    answer: raw,\n    execution_summary: \"Failed to parse JSON output\",\n    confidence: 0,\n    quality_score: 0\n  };\n}\n\nconst task_id = parsed.task_id || \"1\";\nconst answer = parsed.answer || parsed.final_answer || \"\";\nconst execution_summary = parsed.execution_summary || parsed.review_notes || \"\";\nconst quality_score = (parsed.quality_score !== undefined && parsed.quality_score !== null) ? parsed.quality_score : 0;\nconst confidence = (parsed.confidence !== undefined && parsed.confidence !== null) ? parsed.confidence : 0;\n\nlet inputTokens = 0;\nlet outputTokens = 0;\nconst errors = [];\n\nconst modelNodes = [\"OpenAI Chat Model\"];\nfor (const nodeName of modelNodes) {\n  try {\n    const ctx = $node[nodeName]?.context || {};\n    const usage = ctx.tokenUsage || ctx.usageMetadata || ctx.usage || {};\n    inputTokens += usage.promptTokens || usage.inputTokens || usage.prompt_tokens || usage.input_tokens || 0;\n    outputTokens += usage.completionTokens || usage.outputTokens || usage.completion_tokens || usage.output_tokens || usage.candidatesTokenCount || 0;\n  } catch (e) {\n    errors.push(`token_read_${nodeName}: ${e.message}`);\n  }\n}\n\nlet inputTokenMethod = \"api_usage\";\nlet outputTokenMethod = \"api_usage\";\n\nif (inputTokens === 0 && outputTokens === 0) {\n  const effectiveInputText = [\n    \"You are an AI assistant.\\n\\nReturn ONLY valid JSON.\\n\\n{\\n  \\\"task_id\\\": \\\"1\\\",\\n  \\\"answer\\\": \\\"...\\\",\\n  \\\"execution_summary\\\": \\\"...\\\",\\n  \\\"confidence\\\": 0.0\\n}\",\n    $('When chat message received').item.json.chatInput || \n  ].filter(Boolean).join(\"\\n\\n\");\n\n  const effectiveOutputText = [\n    raw\n  ].filter(Boolean).join(\"\\n\\n\");\n\n  inputTokens = Math.max(1, Math.round(effectiveInputText.length / 4));\n  outputTokens = Math.max(1, Math.round(effectiveOutputText.length / 4));\n\n  inputTokenMethod = \"estimated_effective_prompt_length\";\n  outputTokenMethod = \"estimated_response_length\";\n  errors.push(\"token_count_estimated\");\n}\n\nconst totalTokens = inputTokens + outputTokens;\nconst costUsd = parseFloat(((inputTokens / 1e6 * INPUT_PRICE_PER_1M) + (outputTokens / 1e6 * OUTPUT_PRICE_PER_1M)).toFixed(6));\n\nconst costMethod = errors.includes(\"token_count_estimated\") ? \"estimated_char_count\" : \"api_usage\";\n\nreturn [{\n  json: {\n    task_id,\n    answer,\n    execution_summary,\n    confidence,\n    quality_score,\n    raw_output: raw,\n    workflow_version: WORKFLOW_VERSION,\n    prompt_version: PROMPT_VERSION,\n    provider: PROVIDER,\n    model: MODEL,\n    llm_call_count: LLM_CALL_COUNT,\n    start_time_iso: startTimeIso,\n    end_time_iso: endTimeIso,\n    duration_sec: durationSec,\n    input_tokens: inputTokens,\n    output_tokens: outputTokens,\n    total_tokens: totalTokens,\n    input_token_method: inputTokenMethod,\n    output_token_method: outputTokenMethod,\n    cost_usd: costUsd,\n    cost_method: costMethod,\n    input_price_per_1m: INPUT_PRICE_PER_1M,\n    output_price_per_1m: OUTPUT_PRICE_PER_1M,\n    error_message: errors.length > 0 ? errors.join(\"; \") : \"\",\n    retry_count: 0,\n    model_temperature: 1.0,\n    api_status: \"success\"\n  }\n}];"
      },
