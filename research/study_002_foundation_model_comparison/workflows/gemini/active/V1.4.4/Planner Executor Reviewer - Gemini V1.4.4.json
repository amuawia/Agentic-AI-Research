      "id": "a8efe27c-9c07-4008-9f0e-03ec5af46478",
      "name": "Executor Agent"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a strict academic evaluator.\n\nOriginal Task:\n{{ $('When chat message received').item.json.chatInput }}\n\nExecution Result:\n{{ $json.output }}\n\nEvaluate the response on:\n1. Accuracy\n2. Completeness\n3. Reasoning Quality\n4. Clarity\n\nScore from 0.0 to 1.0.\n\nImportant:\n- review_notes must contain your evaluation comments.\n- final_answer must contain the improved final answer to the original task.\n- final_answer must NOT describe or review the response.\n- final_answer must answer the original user task directly.\n- final_answer must be a plain text string, not an object or array.\n- Keep final_answer concise and structured.\n- Do not exceed 250 words.\n- Confidence must be a decimal value between 0.0 and 1.0.\n\nReturn JSON only:\n\n{\n  \"task_id\": \"1\",\n  \"quality_score\": 0.0,\n  \"review_notes\": \"...\",\n  \"final_answer\": \"...\",\n  \"confidence\": 0.0\n}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        928,
        0
      ],
      "id": "dbcc3b66-08db-4ba3-8f86-491e99b7248e",
      "name": "Reviewer Agent"
    },
    {
      "parameters": {
        "jsCode": "// V1.4.4 - Planner Executor Reviewer - all LLM call token estimation\n\nconst startMs = $('Set Start Time').item.json.start_ms || Date.now();\nconst endMs = Date.now();\nconst durationSec = Math.round((endMs - startMs) / 100) / 10;\n\nconst startIso = new Date(startMs).toISOString();\nconst endIso = new Date(endMs).toISOString();\n\nlet raw = $json.output || \"\";\n\nraw = raw\n  .replace(/^```json\\s*/i, '')\n  .replace(/^```\\s*/i, '')\n  .replace(/\\s*```$/i, '')\n  .trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  parsed = {\n    task_id: \"1\",\n    answer: raw,\n    execution_summary: \"Failed to parse JSON output\",\n    confidence: 0,\n    quality_score: 0\n  };\n}\n\nconst task_id = parsed.task_id || \"1\";\nconst answer = parsed.answer || parsed.final_answer || \"\";\nconst execution_summary = parsed.execution_summary || parsed.review_notes || \"\";\nconst quality_score =\n  parsed.quality_score !== undefined && parsed.quality_score !== null\n    ? Math.max(0, Math.min(1, Number(parsed.quality_score)))\n    : 0;\nlet confidence = parsed.confidence !== undefined && parsed.confidence !== null ? Number(parsed.confidence) : 0;\n\nif (confidence > 1 && confidence <= 10) {\n  confidence = confidence / 10;\n}\n\nconfidence = Math.max(0, Math.min(1, confidence));\n\nconst userPrompt = $('When chat message received').item.json.chatInput || \"\";\n\nconst plannerSystemPrompt = `You are a planning agent.\n\nAnalyze the user request.\n\nCreate a step-by-step execution plan.\nKeep the plan concise. Do not exceed 120 words.\nReturn no more than 5 steps.\nConfidence must be a decimal value between 0.0 and 1.0.\n\nReturn ONLY valid JSON.\n\n{\n  \"task_id\":\"1\",\n  \"objective\":\"...\",\n  \"steps\":[\n    \"step1\",\n    \"step2\",\n    \"step3\"\n  ],\n  \"confidence\":0.0\n}`;\n\nconst executorSystemPrompt = `You are an execution agent.\n\nExecute the plan received from the planner.\nKeep the final answer concise and structured.\nDo not exceed 250 words.\nThe \"answer\" field must be a plain text string, not an object or array.\nConfidence must be a decimal value between 0.0 and 1.0.\n\nReturn ONLY valid JSON.\n\n{\n  \"task_id\": \"1\",\n  \"answer\": \"...\",\n  \"execution_summary\": \"...\",\n  \"confidence\": 0.0\n}`;\n\nconst plannerOutput = $('Planner Agent').item.json.output || \"\";\nconst executorOutput = $('Executor Agent').item.json.output || \"\";\nconst reviewerOutput = raw;\n\nconst plannerInputText =\n  plannerSystemPrompt + \"\\n\" +\n  userPrompt;\n\nconst executorInputText =\n  executorSystemPrompt + \"\\n\" +\n  \"Execute the following plan and produce the final answer:\\n\\n\" +\n  plannerOutput;\n\nconst reviewerInputText = `You are a strict academic evaluator.\n\nOriginal Task:\n${userPrompt}\n\nExecution Result:\n${executorOutput}\n\nEvaluate the response on:\n1. Accuracy\n2. Completeness\n3. Reasoning Quality\n4. Clarity\n\nScore from 0.0 to 1.0.\n\nImportant:\n- review_notes must contain your evaluation comments.\n- final_answer must contain the improved final answer to the original task.\n- final_answer must NOT describe or review the response.\n- final_answer must answer the original user task directly.\n- final_answer must be a plain text string, not an object or array.\n- Keep final_answer concise and structured.\n- Do not exceed 250 words.\n- Confidence must be a decimal value between 0.0 and 1.0.\n\nReturn JSON only:\n\n{\n  \"task_id\": \"1\",\n  \"quality_score\": 0.0,\n  \"review_notes\": \"...\",\n  \"final_answer\": \"...\",\n  \"confidence\": 0.0\n}`;\n\nconst inputTokens =\n  Math.max(1, Math.round(plannerInputText.length / 4)) +\n  Math.max(1, Math.round(executorInputText.length / 4)) +\n  Math.max(1, Math.round(reviewerInputText.length / 4));\n\nconst outputTokens =\n  Math.max(1, Math.round(plannerOutput.length / 4)) +\n  Math.max(1, Math.round(executorOutput.length / 4)) +\n  Math.max(1, Math.round(reviewerOutput.length / 4));\n\nconst totalTokens = inputTokens + outputTokens;\n\nconst inputPricePer1M = 1.25;\nconst outputPricePer1M = 10.0;\n\nconst costUsd = Number(((inputTokens / 1000000 * inputPricePer1M) + (outputTokens / 1000000 * outputPricePer1M)).toFixed(6));\n\nreturn [{\n  json: {\n    task_id,\n    answer,\n    execution_summary,\n    confidence,\n    quality_score,\n    raw_output: raw,\n    duration_sec: durationSec,\n    input_tokens: inputTokens,\n    output_tokens: outputTokens,\n    total_tokens: totalTokens,\n    cost_usd: costUsd,\n    cost_method: \"estimated_char_count_all_llm_calls\",\n    input_token_method: \"estimated_effective_prompt_length_all_llm_calls\",\n    output_token_method: \"estimated_all_llm_outputs_length\",\n    error_message: \"token_count_estimated\",\n    retry_count: 0,\n    model_temperature: 1.0,\n    api_status: \"success\",\n    workflow_version: \"V1.4.4\",\n    prompt_version: \"frozen_v1.1\",\n    llm_call_count: 3,\n    start_time_iso: startIso,\n    end_time_iso: endIso,\n    input_price_per_1m: inputPricePer1M,\n    output_price_per_1m: outputPricePer1M\n  }\n}];"
      },
