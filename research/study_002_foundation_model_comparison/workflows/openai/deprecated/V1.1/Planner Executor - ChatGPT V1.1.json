      "parameters": {
        "jsCode": "const raw = $json.output;\n\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (error) {\n  parsed = {\n    task_id: \"1\",\n    answer: raw,\n    execution_summary: \"Failed to parse JSON output\",\n    confidence: 0\n  };\n}\n\nreturn [\n  {\n    json: {\n      task_id: parsed.task_id || \"1\",\n      answer: parsed.answer || \"\",\n      execution_summary: parsed.execution_summary || \"\",\n      confidence: parsed.confidence || 0,\n      raw_output: raw\n    }\n  }\n];"
      },
