    {
      "parameters": {
        "jsCode": "// V1.4.4 - Basic Agent - all LLM call token estimation\n\nconst startMs = $('Set Start Time').item.json.start_ms || Date.now();\nconst endMs = Date.now();\nconst durationSec = Math.round((endMs - startMs) / 100) / 10;\n\nconst startIso = new Date(startMs).toISOString();\nconst endIso = new Date(endMs).toISOString();\n\nlet raw = $json.output || \"\";\n\nraw = raw\n  .replace(/^```json\\s*/i, '')\n  .replace(/^```\\s*/i, '')\n  .replace(/\\s*```$/i, '')\n  .trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  parsed = {\n    task_id: \"1\",\n    answer: raw,\n    execution_summary: \"Failed to parse JSON output\",\n    confidence: 0,\n    quality_score: 0\n  };\n}\n\nconst task_id = parsed.task_id || \"1\";\nconst answer = parsed.answer || parsed.final_answer || \"\";\nconst execution_summary = parsed.execution_summary || parsed.review_notes || \"\";\nlet confidence = parsed.confidence !== undefined && parsed.confidence !== null ? Number(parsed.confidence) : 0;\n\nif (confidence > 1 && confidence <= 10) {\n  confidence = confidence / 10;\n}\n\nconfidence = Math.max(0, Math.min(1, confidence));\nconst quality_score =\n  parsed.quality_score !== undefined && parsed.quality_score !== null\n    ? Math.max(0, Math.min(1, Number(parsed.quality_score)))\n    : confidence;\n\nconst userPrompt = $('When chat message received').item.json.chatInput || \"\";\n\nconst basicSystemPrompt = `You are an AI assistant.\n\nReturn ONLY valid JSON.\n\nKeep the answer concise and structured.\nDo not exceed 250 words.\nThe \"answer\" field must be a plain text string, not an object or array.\nConfidence must be a decimal value between 0.0 and 1.0.\n\n{\n  \"task_id\": \"1\",\n  \"answer\": \"...\",\n  \"execution_summary\": \"...\",\n  \"confidence\": 0.0\n}`;\n\nconst basicInputText = basicSystemPrompt + \"\\n\" + userPrompt;\nconst basicOutputText = raw;\n\nconst inputTokens = Math.max(1, Math.round(basicInputText.length / 4));\nconst outputTokens = Math.max(1, Math.round(basicOutputText.length / 4));\nconst totalTokens = inputTokens + outputTokens;\n\nconst inputPricePer1M = 1.25;\nconst outputPricePer1M = 10.0;\n\nconst costUsd = Number(((inputTokens / 1000000 * inputPricePer1M) + (outputTokens / 1000000 * outputPricePer1M)).toFixed(6));\n\nreturn [{\n  json: {\n    task_id,\n    answer,\n    execution_summary,\n    confidence,\n    quality_score,\n    raw_output: raw,\n    duration_sec: durationSec,\n    input_tokens: inputTokens,\n    output_tokens: outputTokens,\n    total_tokens: totalTokens,\n    cost_usd: costUsd,\n    cost_method: \"estimated_char_count_all_llm_calls\",\n    input_token_method: \"estimated_effective_prompt_length\",\n    output_token_method: \"estimated_all_llm_outputs_length\",\n    error_message: \"token_count_estimated\",\n    retry_count: 0,\n    model_temperature: 1.0,\n    api_status: \"success\",\n    workflow_version: \"V1.4.4\",\n    prompt_version: \"frozen_v1.1\",\n    llm_call_count: 1,\n    start_time_iso: startIso,\n    end_time_iso: endIso,\n    input_price_per_1m: inputPricePer1M,\n    output_price_per_1m: outputPricePer1M\n  }\n}];"
      },
