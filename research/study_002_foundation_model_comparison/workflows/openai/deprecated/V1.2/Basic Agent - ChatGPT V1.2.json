    {
      "parameters": {
        "jsCode": "const startMs=$('Set Start Time').item.json.start_ms||Date.now();\nconst durationSec=Math.round((Date.now()-startMs)/100)/10;\nconst raw=$json.output;let parsed;\ntry{parsed=JSON.parse(raw);}catch(e){parsed={task_id:\"1\",answer:raw,execution_summary:\"Failed to parse JSON output\",confidence:0};}\nconst task_id=parsed.task_id||\"1\";\nconst answer=parsed.answer||\"\";\nconst execution_summary=parsed.execution_summary||\"\";\nconst quality_score=parsed.quality_score||0;\nconst confidence=parsed.confidence||0;\nlet inputTokens=0,outputTokens=0;\n  try { const u0=($node['OpenAI Chat Model'].context?.usageMetadata||$node['OpenAI Chat Model'].context?.tokenUsage||{}); inputTokens+=(u0.promptTokens||u0.inputTokens||u0.prompt_tokens||0); outputTokens+=(u0.candidatesTokenCount||u0.completionTokens||u0.output_tokens||0); } catch(e){}\nconst totalTokens=inputTokens+outputTokens;\nconst costUsd=parseFloat(((inputTokens/1e6*2.5)+(outputTokens/1e6*10.0)).toFixed(6));\nreturn [{json:{task_id,answer,execution_summary,confidence,quality_score,raw_output:raw,duration_sec:durationSec,input_tokens:inputTokens,output_tokens:outputTokens,total_tokens:totalTokens,cost_usd:costUsd}}];"
      },
